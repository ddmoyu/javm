{
  "name": "javm",
  "version": "1.0.0-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prototype": "vp dev --config docs/prototypes/javm-ui/vite.config.ts",
    "prototype:build": "vp build --config docs/prototypes/javm-ui/vite.config.ts",
    "prototype:velvet": "vp dev --config docs/prototypes/javm-mantine/vite.config.ts",
    "prototype:velvet:build": "vp build --config docs/prototypes/javm-mantine/vite.config.ts",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "vp check --no-fmt --no-lint",
    "format": "vp fmt",
    "catalog:collect": "node --use-env-proxy scripts/collect-javbus-catalog.mjs",
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "test": "vp test run --passWithNoTests",
    "desktop:setup": "neu update",
    "desktop:dev": "pnpm native:build && neu run",
    "desktop:build": "pnpm native:build --Release && vp build && node scripts/build-desktop.mjs",
    "desktop:offline": "pnpm offline:setup && pnpm desktop:build && node scripts/package-offline.mjs",
    "offline:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-offline-tools.ps1",
    "dependencies:restore": "node scripts/install-dependencies.mjs",
    "release:package": "node scripts/package-offline.mjs && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1 && node scripts/release-assets.mjs",
    "downloads:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-download-tools.ps1",
    "test:downloads": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-downloads.ps1",
    "test:downloads:public": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-public-downloads.ps1",
    "test:playback": "node scripts/test-playback.mjs",
    "test:playback:preferences": "node scripts/test-playback.mjs --preferences",
    "test:metadata": "node scripts/test-metadata.mjs",
    "test:offline": "node scripts/test-offline.mjs",
    "test:player-window": "node scripts/test-playback.mjs --window",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "native:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1"
  },
  "dependencies": {
    "@fancyapps/ui": "6.1.14",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@neutralinojs/lib": "6.10.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.13",
    "@videojs/hlsjs-video": "10.0.1",
    "@videojs/react": "10.0.1",
    "hls.js": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.8.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "pnpm@12.10.1"
}
