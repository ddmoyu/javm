{
  "name": "javm",
  "version": "1.0.15",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm catalog:build && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "vp check --no-fmt --no-lint",
    "format": "vp fmt",
    "catalog:collect": "node --use-env-proxy scripts/collect-javbus-catalog.mjs",
    "catalog:build": "node --disable-warning=ExperimentalWarning scripts/build-catalog-seed.mjs",
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "test": "vp test run --passWithNoTests",
    "desktop:setup": "node scripts/setup-desktop.mjs",
    "desktop:dev": "pnpm native:build && neu run",
    "desktop:build": "pnpm native:build --Release && pnpm build && node scripts/build-desktop.mjs",
    "desktop:offline": "pnpm offline:setup && pnpm desktop:build && node scripts/package-offline.mjs",
    "desktop:installer": "node scripts/package-installer.mjs",
    "offline:setup": "node scripts/setup-offline-tools.mjs",
    "metatube:build": "node --use-env-proxy scripts/build-metatube-lite.mjs",
    "metatube:verify": "node --disable-warning=ExperimentalWarning scripts/verify-metatube-lite.mjs",
    "downloads:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-download-tools.ps1",
    "test:downloads": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-downloads.ps1",
    "test:downloads:public": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-public-downloads.ps1",
    "test:playback": "node scripts/test-playback.mjs",
    "test:playback:preferences": "node scripts/test-playback.mjs --preferences",
    "test:metadata": "node scripts/test-metadata.mjs",
    "test:offline": "node scripts/test-offline.mjs",
    "test:player-window": "node scripts/test-playback.mjs --window",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "native:build": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "@fancyapps/ui": "6.1.15",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@neutralinojs/lib": "6.10.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.22",
    "@videojs/hlsjs-video": "10.2.0",
    "@videojs/react": "10.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.8.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "pnpm@12.15.0"
}
