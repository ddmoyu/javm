# 完整媒体服务在隔离扩展中编译和验证，不替换应用的 bin 或实际数据库。
add_executable(javm_library_fixture ../database/src/main.cpp)
target_link_libraries(javm_library_fixture PRIVATE javm_media javm_http)
target_include_directories(javm_library_fixture PRIVATE ../database/src)
target_compile_definitions(javm_library_fixture PRIVATE
    JAVM_VERSION="${JAVM_APP_VERSION}" JAVM_WITH_MEDIA=1
    JAVM_USE_WINHTTP=$<STREQUAL:${JAVM_EXTENSION_TRANSPORT},winhttp>)
if(JAVM_EXTENSION_TRANSPORT STREQUAL "winhttp")
    target_sources(javm_library_fixture PRIVATE ../database/src/extension_winhttp.cpp)
    target_link_libraries(javm_library_fixture PRIVATE winhttp iphlpapi ws2_32 user32)
else()
    target_sources(javm_library_fixture PRIVATE ../database/src/extension_curl.cpp)
    target_link_libraries(javm_library_fixture PRIVATE CURL::libcurl)
endif()
set_target_properties(javm_library_fixture PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
add_executable(javm_file_platform_test "${PROJECT_SOURCE_DIR}/tests/native/file_platform_test.cpp")
target_link_libraries(javm_file_platform_test PRIVATE javm_media)
add_test(NAME javm_file_platform COMMAND javm_file_platform_test)
foreach(target javm_library_fixture javm_file_platform_test)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
endforeach()
