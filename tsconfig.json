{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite-plus/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "frontend/src",
    "frontend/vite.config.ts",
    "vite.config.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "docs/prototypes/javm-ui/**/*.ts",
    "docs/prototypes/javm-ui/**/*.tsx",
    "docs/prototypes/javm-mantine/**/*.ts",
    "docs/prototypes/javm-mantine/**/*.tsx"
  ]
}
