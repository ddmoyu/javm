{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "net.ddmoyu.javm.dev",
  "applicationName": "JAVM",
  "applicationIcon": "resources/icon.png",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/frontend/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.exit",
    "app.getConfig",
    "storage.getKeys",
    "storage.getData",
    "storage.setData",
    "os.showFolderDialog",
    "window.minimize",
    "window.unminimize",
    "window.isMinimized",
    "window.setTitle",
    "window.move",
    "window.getPosition",
    "window.getSize",
    "window.setSize",
    "window.setBorderless",
    "window.maximize",
    "window.unmaximize",
    "window.isMaximized",
    "window.isFullScreen",
    "window.beginDrag",
    "app.broadcast",
    "extensions.dispatch",
    "extensions.getStats",
    "os.getPath",
    "os.getEnv",
    "os.spawnProcess",
    "os.getSpawnedProcesses",
    "os.updateSpawnedProcess",
    "os.execCommand",
    "os.open",
    "os.showOpenDialog",
    "os.setTray",
    "os.showMessageBox",
    "filesystem.createDirectory",
    "filesystem.readDirectory",
    "filesystem.getStats",
    "filesystem.readFile",
    "filesystem.readBinaryFile",
    "filesystem.writeFile",
    "filesystem.appendFile",
    "filesystem.move",
    "filesystem.remove",
    "window.hide",
    "window.show",
    "window.focus",
    "server.mount",
    "server.unmount",
    "server.getMounts"
  ],
  "extensions": [
    {
      "id": "net.ddmoyu.javm.database",
      "commandWindows": "\"${NL_PATH}/bin/javm_database.exe\" --database \"${NL_OSDATAPATH}/JAVM/downloads-v1.sqlite3\""
    }
  ],
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "JAVM",
      "icon": "/resources/icon.png",
      "borderless": true,
      "transparent": false,
      "width": 1100,
      "height": 760,
      "minWidth": 760,
      "minHeight": 540,
      "center": true,
      "resizable": true,
      "exitProcessOnClose": false,
      "useSavedState": true,
      "injectGlobals": true,
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "javm",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0",
    "resourcesPath": "/dist/frontend/",
    "distributionPath": "/dist/desktop",
    "frontendLibrary": {
      "projectPath": ".",
      "devUrl": "http://127.0.0.1:5173",
      "devCommand": "pnpm run dev"
    },
    "copyItems": [
      "bin/javm_database.exe",
      "bin/MediaInfo.dll",
      "bin/mediainfo-lite.json",
      "bin/licenses",
      "bin/tools",
      "resources/icon.png"
    ]
  }
}
